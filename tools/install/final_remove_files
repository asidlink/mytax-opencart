<?php
/**
 * Финальное удаление всех следов mytax с диска
 * (БД уже чистая - проверено диагностикой)
 */

$siteRoot = 'C:/sites/metalka';

echo "Удаление файлов mytax...\n\n";

// 1. extension/mytax (главный каталог расширения - нестандартный путь OpenCart 3)
$path = "$siteRoot/extension/mytax";
if (is_dir($path)) {
    echo "Удаление: extension/mytax\n";
    $rii = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, RecursiveDirectoryIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST
    );
    foreach ($rii as $f) {
        $f->isDir() ? @rmdir($f->getRealPath()) : @unlink($f->getRealPath());
    }
    @rmdir($path);
    if (!is_dir($path)) echo "  [OK] extension/mytax удалён\n";
    else echo "  [FAIL] Не удалось удалить extension/mytax\n";
} else {
    echo "  extension/mytax не найден\n";
}

