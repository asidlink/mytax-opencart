<?php
/**
 * Сборка mytax.ocmod.zip для OpenCart 4.1.0.3
 * Правило OC4: файлы в архиве указываются ОТНОСИТЕЛЬНО корня сайта
 * Для admin части: admin/... -> будет скопировано в dmt/...
 * Для catalog: catalog/... -> скопировано в catalog/...
 * Для model checkout: catalog/model/checkout/mytax.php
 * 
 * Установщик расширений OC4 сам помещает файлы в правильную директорию,
 * используя install.json с указанием code="mytax"
 */
$zip = new ZipArchive();
@unlink('C:/sites/metalka/mytax.ocmod.zip');
if ($zip->open('C:/sites/metalka/mytax.ocmod.zip', ZipArchive::CREATE) !== true) die("FAIL");

$tM = 'C:/Users/admin/AppData/Local/Temp/mytax_zip_build';
$tP = 'C:/Users/admin/AppData/Local/Temp/zip_final';

// install.json - code указывает на mytax, установщик сам распознает
$zip->addFromString('install.json', json_encode([
    'code' => 'mytax',
    'name' => 'Мой налог: кассовые чеки для ИП (НПД)',
    'version' => '2.0.1',
    'author' => 'MyTax-Service',
    'link' => 'https://github.com/Ga1maz/fns-receipt-service'
], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));
echo "  + install.json\n";

// ===== ПУТИ ОТНОСИТЕЛЬНО КОРНЯ САЙТА =====
// В OC4 установщик использует пути как в архиве, но для admin использует название папки админа

// admin/controller/extension/module/mytax.php -> dmt/controller/extension/module/mytax.php
$zip->addFromString(
    'admin/controller/extension/module/mytax.php',
    file_get_contents("$tM/admin/controller/module/mytax.php")
);
echo "  + admin/controller/extension/module/mytax.php\n";

// admin/model/extension/module/mytax.php
$zip->addFromString(
    'admin/model/extension/module/mytax.php',
    file_get_contents("$tM/admin/model/module/mytax.php")
);
echo "  + admin/model/extension/module/mytax.php\n";

// admin/language/ru-ru/extension/module/mytax.php
$zip->addFromString(
    'admin/language/ru-ru/extension/module/mytax.php',
    file_get_contents("$tM/admin/language/ru-ru/module/mytax.php")
);
echo "  + admin/language/ru-ru/extension/module/mytax.php\n";

// admin/view/template/extension/module/mytax.twig
$zip->addFromString(
    'admin/view/template/extension/module/mytax.twig',
    file_get_contents("$tM/admin/view/template/module/mytax.twig")
);
echo "  + admin/view/template/extension/module/mytax.twig\n";

// ===== CATALOG =====
// catalog/controller/extension/module/mytax.php
$zip->addFromString(
    'catalog/controller/extension/module/mytax.php',
    '<?php
namespace Opencart\Catalog\Controller\Extension\Mytax\Module;
class Mytax extends \Opencart\System\Engine\Controller {
    public function index(array $args): void {}
    public function orderHistory(string &$route, array &$args): void {
        $this->load->model("extension/mytax/checkout/mytax");
        $order_id = $args[0];
        $this->load->model("checkout/order");
        $order_info = $this->model_checkout_order->getOrder($order_id);
        if ($order_info) $this->model_extension_mytax_checkout_mytax->createReceipt($order_id, $order_info["email"]);
    }
    public function viewOrderHistory(string &$route, array &$args): void {
        $this->load->model("extension/mytax/checkout/mytax");
        $order_id = $args["order_id"] ?? 0;
        if ($order_id) { $r = $this->model_extension_mytax_checkout_mytax->getReceiptByOrderId($order_id); if ($r) $args["mytax"] = $r; }
    }
    public function viewOrderAdd(string &$route, array &$args): void {
        $this->load->model("extension/mytax/checkout/mytax");
        $order_id = $args["order_id"] ?? 0;
        if ($order_id) { $r = $this->model_extension_mytax_checkout_mytax->getReceiptByOrderId($order_id); if ($r) $args["mytax"] = $r; }
    }
}');
echo "  + catalog/controller/extension/module/mytax.php\n";

// catalog/model/extension/checkout/mytax.php -> БЕЗ mytax в пути, потому что namespace Opencart\Catalog\Model\Extension\Mytax\Checkout
$zip->addFromString(
    'catalog/model/extension/mytax/checkout/mytax.php',
    file_get_contents("$tP/catalog/model/checkout/mytax.php")
);
echo "  + catalog/model/extension/mytax/checkout/mytax.php\n";

